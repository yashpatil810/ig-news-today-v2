# ============================================
# WordPress Project - Root .gitignore
# ============================================

# ----- WordPress Core (don't track core files) -----
wp-admin/
wp-includes/
wp-*.php
!wp-config-sample.php
index.php
license.txt
readme.html
xmlrpc.php

# ----- WP Config & Sensitive Files -----
wp-config.php
.htaccess
.htaccess.bk
php.ini
web.config
.env
.env.*

# ----- WP Content -----
# Uploads (media files - too large for Git)
wp-content/uploads/

# Plugins (install on server separately)
wp-content/plugins/

# Cache
wp-content/cache/
wp-content/advanced-cache.php
wp-content/wp-cache-config.php
wp-content/debug.log

# All themes EXCEPT our custom theme
wp-content/themes/*
!wp-content/themes/newstoday/

# Upgrade files
wp-content/upgrade/
wp-content/backups/

# ----- Dependencies -----
node_modules/
vendor/

# ----- Build artifacts (generated by CI/CD) -----
# Uncomment below if you want to build only in CI:
# wp-content/themes/newstoday/assets/dist/

# ----- OS Files -----
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# ----- Editor / IDE -----
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# ----- Logs & Temp -----
*.log
npm-debug.log*
yarn-debug.log*
*.zip
*.sql
*.tar.gz
*.bak

# ----- Package locks (theme has its own) -----
# Keep package-lock.json in theme for reproducible builds
